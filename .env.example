# ---- Option A (default): local model via Ollama, NO API key needed ----
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ---- Option B: Google Gemini (only used if a key is present) ----
# Copy this file to ".env" and paste your key below. Never commit ".env".
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Server ----
PORT=3000
